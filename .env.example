# ---------- Core ----------
NODE_ENV=development
# PostgreSQL (docker compose maps to host port 5434)
DATABASE_URL=postgresql://collex:collex_dev_password@localhost:5434/collex
# Separate database used by integration tests (created automatically by the test setup)
TEST_DATABASE_URL=postgresql://collex:collex_dev_password@localhost:5434/collex_test

# ---------- API ----------
API_PORT=4000
# Public origin of the web app (used for CORS and links in notifications)
WEB_ORIGIN=http://localhost:3000
# 32+ random characters. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Session lifetime in hours
SESSION_TTL_HOURS=12
# Login attempts per IP per minute
LOGIN_RATE_LIMIT_PER_MINUTE=10
# Set to true behind HTTPS in production
COOKIE_SECURE=false

# ---------- Sensitive data encryption ----------
# 32-byte key, base64. Used for AES-256-GCM encryption of identity-document files (local storage)
# and of identity document numbers / MFA secrets in the database.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY

# ---------- Private file storage ----------
# local = encrypted files on disk (development); s3 = S3-compatible private bucket (production)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=collex-private
S3_ACCESS_KEY_ID=collexminio
S3_SECRET_ACCESS_KEY=collexminio_dev_password
S3_FORCE_PATH_STYLE=true
# Max identity-document upload size in megabytes
UPLOAD_MAX_MB=10
# none = mark files SKIPPED (documented quarantine workflow); clamav = scan via clamd
MALWARE_SCANNER=none
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# ---------- Payments ----------
# mock = development-only provider (refused when NODE_ENV=production); stripe = Stripe official API
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MOCK_WEBHOOK_SECRET=dev-mock-webhook-secret

# ---------- Notifications ----------
# log = write redacted delivery records only (no real messages); smtp = send via SMTP
EMAIL_PROVIDER=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Collex Hotel <no-reply@example.com>"
SMS_PROVIDER=log

# ---------- OCR (optional, disabled by default) ----------
OCR_PROVIDER=none

# ---------- Redis (optional: rate-limit storage / cache) ----------
REDIS_URL=redis://localhost:6380

# ---------- Web ----------
# URL the Next.js server uses to reach the API (proxied under /api)
API_INTERNAL_URL=http://localhost:4000

# ---------- Development seed (never used in production) ----------
SEED_DEFAULT_PASSWORD=ChangeMe-Dev-Only-2026
